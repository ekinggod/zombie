# ============================================
# Unity 项目 .gitignore
# 注意：Assets/、Packages/、ProjectSettings/ 必须提交，不要忽略
# ============================================

# ---------- Unity 自动生成，无需版本管理 ----------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity 崩溃日志 / 系统信息
sysinfo.txt
crashlytics-build.properties
*.stackdump

# ---------- IDE / 编辑器 ----------
/.vs/
/.idea/
/.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------- 打包产物 ----------
*.apk
*.aab
*.unitypackage
*.app
*.ipa

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
